APP_DOMAIN=homework.example.com
CADDY_EMAIL=you@example.com

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_SSL=0
SMTP_STARTTLS=1
EMAIL_FROM=sender@example.com

HW_WEB_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
HW_WEB_ADMIN_TOKEN=replace-with-a-long-random-admin-token
HW_WEB_SECURE_COOKIES=1
HW_WEB_NOVNC_URL=https://homework.example.com/vnc/vnc.html?autoconnect=1&resize=scale

# VNC passwords are limited to 8 characters by x11vnc.
NOVNC_PASSWORD=change8
